# Copy to .env.local. Full table of vars: README.md → "Environment variables".
# AI provider keys are NOT client vars — they are Cloud Functions secrets
# (ANTHROPIC_API_KEY, GEMINI_API_KEY, DATALAB_API_KEY).

# Firebase (required)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Admin/diagnostics screens: comma-separated Firebase uids
VITE_RXTRACK_ADMIN_UIDS=

# OCR (optional) — local Marker first, then Datalab, then Mistral (~$1 / 1000 pages)
VITE_MARKER_LOCAL_URL=
VITE_DATALAB_URL=
VITE_DATALAB_API_KEY=
VITE_MISTRAL_API_KEY=

# focus-hud activity signals (optional; separate Firebase project)
VITE_FOCUSHUD_API_KEY=
VITE_FOCUSHUD_AUTH_DOMAIN=
VITE_FOCUSHUD_PROJECT_ID=
VITE_FOCUSHUD_APP_ID=

# Dev only
# VITE_FIREBASE_EMULATORS=1
# VITE_DEV_USER_ID=
